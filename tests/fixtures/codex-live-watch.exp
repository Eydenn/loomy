# Synthetic desktop schema, twenty randomized-phase screen latency trials in both default views.
set timeout 10
set repo [file normalize [file join [file dirname [info script]] .. ..]]
# Explicit stderr routing avoids Tcl's sandbox-incompatible temporary error file.
set work [file normalize [exec mktemp -d /tmp/loomy-codex-live-pty.XXXXXX 2>@1]]
set root [file join $work project]
set sessions [file join $work codex sessions]
set fixture [file join $repo tests fixtures codex-native.pl]
file mkdir [file join $work home] [file join $work config]
set child ""
set maximum 0
log_user 0
set result [catch {
    exec perl $fixture seed $root $sessions [pid] 2>@1
    exec perl $fixture app $root $sessions [pid] 2>@1
    exec perl $fixture second-lead $root $sessions [pid] 2>@1
    spawn env HOME=$work/home XDG_CONFIG_HOME=$work/config CODEX_HOME=$work/codex LOOMY_HOME=$repo LOOMY_LANG=en LOOMY_UI_LANG=en LOOMY_NO_AUTOUPDATE=1 LOOMY_CATALOG_CHECK=0 PATH=$repo/tests/stubs:/usr/bin:/bin:/usr/sbin:/sbin NO_COLOR=1 COLUMNS=170 LINES=65 TERM=xterm-256color bash $repo/scripts/loomy-status.sh --root $root --watch --full
    set child [exp_pid]
    expect {
        -re {codex app 00000001[^\r\n]*running} {}
        timeout { error "Desktop lead missing on PTY" }
        eof { error "Watch exited before desktop lead" }
    }
    for {set trial 30} {$trial < 50} {incr trial} {
        if {$trial == 40} { send "a" }
        # Running children must be visible without arrow-key navigation.
        after [expr {int(rand()*240)}]
        # Including process startup gives a conservative bound on write/flush -> completed row.
        set started [clock clicks -microseconds]
        exec perl $fixture live-child $root $sessions $trial 2>@1
        # Brackets escaped: inside double quotes Tcl would run them as commands.
        set pattern "latency$trial\[^\\r\\n\]*running · \[0-9\]+:\[0-9\]\[0-9\]"
        expect {
            -re $pattern {}
            timeout { error "New desktop child latency$trial missing" }
            eof { error "Watch exited during latency trials" }
        }
        set elapsed [expr {([clock clicks -microseconds]-$started)/1000.0}]
        if {$elapsed > $maximum} { set maximum $elapsed }
        if {$elapsed >= 600} { error "Desktop trial $trial took $elapsed ms (>=600 ms)" }
    }
    send "q"
    expect {
        eof {}
        timeout { error "Watch q unresponsive" }
    }
} reason]
if {$child ne ""} { catch {exec kill $child 2>@1}; catch {close}; catch {wait} }
file delete -force $work
if {$result != 0} { puts stderr $reason; exit 1 }
puts "S1 PTY: 20 desktop child frames, maximum $maximum ms, tree/list/navigation/q passed"
