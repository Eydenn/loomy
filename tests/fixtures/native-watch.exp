# End-to-end sampler refresh: no CLI agents, network, or transcript data.
set timeout 20
set repo [file normalize [file join [file dirname [info script]] .. ..]]
set work [file normalize [exec mktemp -d /tmp/loomy-native-pty.XXXXXX]]
set root [file join $work project]
set home [file join $work home]
set sessions [file join $work codex sessions]
file mkdir $home [file join $work config]
set fixture [file join $repo tests fixtures codex-native.pl]
exec perl $fixture seed $root $sessions [pid]
log_user 0
log_file -noappend [file join $work native-watch.log]
spawn env HOME=$home XDG_CONFIG_HOME=$work/config CODEX_HOME=$work/codex LOOMY_HOME=$repo LOOMY_LANG=en LOOMY_NO_AUTOUPDATE=1 LOOMY_CATALOG_CHECK=0 PATH=$repo/tests/stubs:/usr/bin:/bin:/usr/sbin:/sbin NO_COLOR=1 LOOMY_TREE=list COLUMNS=170 LINES=65 TERM=xterm-256color bash $repo/scripts/loomy-status.sh --root $root --watch --full
set code 0
foreach identity {consolidation enrichment review} {
    expect {
        -exact $identity {}
        timeout { set code 1 }
        eof { set code 1 }
    }
    if {$code != 0} { break }
}
if {$code == 0} {
    exec perl $fixture finish $root $sessions [pid]
    foreach outcome {"interrupted" "waiting since"} {
        expect {
            -exact $outcome {}
            timeout { set code 1 }
            eof { set code 1 }
        }
        if {$code != 0} { break }
    }
}
catch { send "q" }
expect {
    eof {}
    timeout { set code 1; catch { exec kill [exp_pid] }; catch { close } }
}
catch { wait }
file delete -force $work
if {$code != 0} { puts stderr "Native watch PTY lifecycle refresh failed"; exit 1 }
puts "Native watch PTY: three identities and live completion refresh passed"
