#!/usr/bin/env bash
# loomy — point d'entrée unique de Loomy. Compatible bash 3.2.
# Installé via npm, bun, Homebrew ou install.sh ; tous pointent vers ce fichier.
set -euo pipefail

# Dossier d'installation réel (les liens symboliques créés par npm, bun ou Homebrew sont résolus).
_realpath() {
  local p="$1" link
  while [[ -L "$p" ]]; do
    link="$(readlink "$p")"
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
}
LOOMY_HOME="$(cd "$(dirname "$(_realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
S="$LOOMY_HOME/scripts"
LOOMY_REPO="${LOOMY_REPO:-Eydenn/loomy}"
VERSION="$(cat "$LOOMY_HOME/VERSION" 2>/dev/null || echo "?")"

# shellcheck source=../scripts/lib/ui.sh
source "$S/lib/ui.sh"
# shellcheck source=../scripts/lib/config.sh
source "$S/lib/config.sh"

# shellcheck source=../scripts/lib/models.sh
source "$S/lib/models.sh"
project_root() { ai_project_root; }

INVOKED="${BASH_SOURCE[0]}"

# ---------------------------------------------------------------- installations
# method_of <chemin appelé> <dossier réel> : brew, npm, bun, git (clone + install.sh) ou manuel.
# L'ordre compte : npm installé avec le Node de Homebrew range ses paquets dans /opt/homebrew/lib/node_modules,
# et bun peut ranger les siens dans ~/node_modules (on reconnaît alors bun au chemin appelé, ~/.bun/bin).
method_of() {
  case "$1" in */.bun/*) echo "bun"; return 0 ;; esac
  case "$2" in
    */.bun/*|*/install/global/node_modules/*) echo "bun" ;;
    */node_modules/*) echo "npm" ;;
    */Cellar/*) echo "brew" ;;
    *) if [[ -d "$2/.git" ]]; then echo "git"; else echo "manuel"; fi ;;
  esac
}
install_method() { method_of "$INVOKED" "$LOOMY_HOME"; }

# home_of <exécutable loomy> : dossier d'installation réel (lien résolu, ou cible du petit script d'install.sh).
home_of() {
  local p="$1" t
  if [[ ! -L "$p" ]] && grep -q "Installé par install.sh de Loomy" "$p" 2>/dev/null; then
    t="$(sed -n 's/^exec "\(.*\)\/bin\/loomy" .*/\1/p' "$p" | head -1)"
    if [[ -n "$t" ]]; then echo "$t"; return 0; fi
  fi
  (cd "$(dirname "$(_realpath "$p")")/.." 2>/dev/null && pwd)
}

# loomy_installs : « méthode<TAB>dossier<TAB>commande » pour chaque loomy du PATH, dans l'ordre du PATH.
loomy_installs() {
  local p h seen=" "
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    h="$(home_of "$p")" || continue
    case "$seen" in *" $h "*) continue ;; esac
    seen="$seen$h "
    printf '%s\t%s\t%s\n' "$(method_of "$p" "$h")" "$h" "$p"
  done < <(type -ap loomy 2>/dev/null || true)
}

uninstall_cmd() {
  case "$1" in
    brew) echo "brew uninstall eydenn/tap/loomy" ;; npm) echo "npm uninstall -g loomy" ;;
    bun) echo "bun remove -g loomy" ;; *) echo "rm $3" ;;
  esac
}

# show_installs : l'installation utilisée, puis les autres copies trouvées dans le PATH et comment les retirer.
show_installs() {
  local m h p v n=0 first=1
  while IFS=$'\t' read -r m h p; do
    [[ -n "$m" ]] || continue
    n=$(( n + 1 ))
    v="$(cat "$h/VERSION" 2>/dev/null || echo "?")"
    if [[ "$h" == "$LOOMY_HOME" ]]; then
      ui_ok "$m v$v" "${h/#$HOME/~} · $( (( first )) && echo "utilisée par la commande loomy" || echo "masquée par une autre dans le PATH")"
    else
      ui_warn "$m v$v" "${h/#$HOME/~} · autre installation$( (( first )) && echo ", utilisée par la commande loomy")"
      ui_rail "    ${C_DIM}pour la retirer :${C_RESET} $(uninstall_cmd "$m" "$h" "$p")"
    fi
    first=0
  done < <(loomy_installs)
  if (( n == 0 )); then ui_warn "loomy absent du PATH" "installation : voir le README"; fi
  if (( n > 1 )); then ui_info "plusieurs installations : garde-en une seule pour éviter les versions mélangées"; fi
  return 0
}

# ---------------------------------------------------------------- aide
# L'aide s'écrit sur la sortie standard (loomy help | less), en couleurs seulement vers un terminal.
_h_color() {
  if [[ ( -t 1 || -n "${LOOMY_FORCE_COLOR:-}" ) && -z "${NO_COLOR:-}" ]]; then
    HB="$C_BOLD"; HD="$C_DIM"; HR="$C_RESET"; HL="$C_RAIL"; HA="$C_BOX"
  else
    HB=""; HD=""; HR=""; HL=""; HA=""; C_BOLD=""; C_DIM=""; C_RESET=""; C_RAIL=""; C_BRAND=""
  fi
}
_h_group() { printf '%s\n%s◇%s  %s%s%s\n' "${HL}│${HR}" "$HL" "$HR" "$HB" "$1" "$HR"; }
# _h_cmd <commande> <arguments> <description> : colonne de commandes alignée, description repliée à la largeur du terminal.
_h_cmd() {
  local left="loomy $1${2:+ $2}" col=34 len i indent
  _ui_term_size
  _ui_strlen "$left"; len=$UI_LEN
  # Deux colonnes à partir de 80 colonnes ; sinon la description passe sous la commande.
  if (( UI_COLS >= 80 && len + 2 <= col )); then
    _ui_wrap "$3" $(( UI_COLS - col - 5 ))
    _ui_pad "$left" "$col"
    printf '%s│%s  %sloomy%s %s%s%s%s%s\n' "$HL" "$HR" "$HD" "$HR" "$HB" "$1" "$HR" "${2:+ ${HA}$2${HR}}" "${UI_PADDED:${#left}}${UI_LINES[0]:-}"
    indent=$col
  else
    printf '%s│%s  %sloomy%s %s%s%s%s\n' "$HL" "$HR" "$HD" "$HR" "$HB" "$1" "$HR" "${2:+ ${HA}$2${HR}}"
    if (( UI_COLS >= 80 )); then indent=$col; else indent=4; fi
    _ui_wrap "$3" $(( UI_COLS - indent - 5 ))
    _ui_pad "" "$indent"; printf '%s│%s  %s%s\n' "$HL" "$HR" "$UI_PADDED" "${UI_LINES[0]:-}"
  fi
  _ui_pad "" "$indent"
  for (( i = 1; i < ${#UI_LINES[@]}; i++ )); do printf '%s│%s  %s%s\n' "$HL" "$HR" "$UI_PADDED" "${UI_LINES[$i]}"; done
  return 0
}

usage() {
  _h_color
  if [[ -n "${LOOMY_NO_HEADER:-}" ]]; then :
  elif [[ -t 1 ]] && ui_logo_ok; then
    _ui_logo_lines "  "; printf '\n'; printf '%s\n' "${UI_LINES[@]}"
  else
    printf '\n  %sLoomy%s\n' "$C_BRAND" "$HR"
  fi
  local tag="v$VERSION" l pad item
  printf '\n  %s%s%s  %sDémarre et structure tes projets avec Codex et Claude Code%s\n' "$HB" "$tag" "$HR" "$HB" "$HR"
  _ui_pad "" $(( ${#tag} + 4 )); pad="$UI_PADDED"
  _ui_term_size
  # Repli entre les éléments (jamais au milieu de l'un d'eux).
  l=""
  for item in "questionnaire" "structure prête pour les agents" "orchestrateur et rôles dédiés" "suivi en direct"; do
    if [[ -n "$l" ]] && (( ${#l} + ${#item} + 3 > UI_COLS - ${#pad} - 2 )); then printf '%s%s%s%s\n' "$pad" "$HD" "$l" "$HR"; l=""; fi
    l="${l:+$l · }$item"
  done
  printf '%s%s%s%s\n' "$pad" "$HD" "$l" "$HR"
  printf '\n'
  printf '%s┌%s  %sUsage : loomy <commande> [arguments] · loomy seul : accueil du projet%s\n' "$HL" "$HR" "$HD" "$HR"
  _h_group "PROJET"
  _h_cmd init "[dossier] [options]" "Crée ou initialise un projet, nouveau ou existant (propose de créer le dossier d'après le nom du projet) : questionnaire, puis structure mise en place par l'orchestrateur. Projet déjà initialisé : reprendre, --update, --reset"
  _h_cmd brief "" "Relance le questionnaire du projet courant"
  _h_cmd start "[--resume|--new|--print] [--watch]" "Démarre ou reprend la session de l'orchestrateur, au bon endroit du projet (session fermée ? c'est ici) ; --watch ouvre le suivi en direct à côté"
  _h_cmd effort "[<rôle>] [niveau|--reset]" "Effort de raisonnement de l'orchestrateur (ou d'un rôle) pour ce projet : low, medium, high, xhigh, max"
  _h_cmd route "[commande]" "Matrice rôle → modèle → effort (lead, get <rôle>, markdown, all, claude-agents, codex-profiles)"
  _h_cmd delegate "<claude|codex> <rôle> \"tâche\"" "Confie un rôle à Claude ou à Codex via les bridges"
  _h_cmd privacy "[mode|sync|restore]" "Visibilité des fichiers IA : versionnés, locaux, ou dans un dépôt privé séparé"
  _h_cmd worktrees "<tâche> [base]" "Crée deux worktrees séparés pour le mode parallèle"
  _h_group "SUIVI"
  _h_cmd status "" "Statut du projet : phases, délégations en cours, activité, coûts, Git"
  _h_cmd watch "[N]" "Suivi en direct (touches : q, c vue, l journal, s session)"
  _h_cmd log "[-n N] [-f] [--raw]" "Journal lisible des phases, délégations et sessions (--raw : JSON)"
  _h_cmd feedback "[\"message\"]" "Signale un bug ou une idée : issue GitHub pré-remplie (versions, état du projet anonymisé), envoyée seulement après ton accord"
  _h_group "MACHINE"
  _h_cmd doctor "[--fix] [--live]" "Vérifie les prérequis ; --fix corrige, --live teste chaque modèle"
  _h_cmd config "[list|get|set]" "Préférences : forfaits Claude et Codex"
  _h_cmd update "[--catalog]" "Met à jour Loomy selon sa méthode d'installation ; --catalog : seulement le catalogue des modèles et des prix"
  _h_cmd version "[--all]" "Version et méthode d'installation ; --all liste toutes les installations trouvées"
  _h_cmd uninstall "" "Montre comment désinstaller Loomy (selon l'installation) et le retirer d'un projet"
  printf '%s│%s\n%s└%s  %sAide d'"'"'une commande : loomy help <commande>%s\n\n' "$HL" "$HR" "$HL" "$HR" "$HD" "$HR"
}

# Aide courte des commandes gérées directement ici.
sub_help() {
  case "$1" in
    log) echo "Usage : loomy log [-n N] [-f] [--raw] [--since AAAA-MM-JJ] [--csv]"; echo "Affiche les N derniers événements du journal (20 par défaut), lisibles et à l'heure locale ; -f le suit en continu ; --raw donne les lignes JSON brutes (.loomy/logs/events.jsonl)." ;;
    config) echo "Usage : loomy config [list | get <clé> | set <clé> <valeur>]"
            echo "Clés : plan_claude (api, pro, max5, max20, team, enterprise), plan_codex (api, plus, pro100, pro200, business, enterprise),"
            echo "       plan_claude_price, plan_codex_price (prix mensuel en \$ si différent du prix public),"
            echo "       start_watch (yes : loomy start ouvre aussi le suivi en direct à côté de la session),"
            echo "       notify (no : loomy watch ne notifie plus les changements de phase, échecs et fin de bootstrap),"
            echo "       screen (alt : écran séparé ; clear : écran et historique vidés, pour les terminaux sans écran séparé ; auto)."
            echo "Fichier : $(loomy_config_file)" ;;
    delegate) echo "Usage : loomy delegate <claude|codex> <rôle> \"tâche\""
              echo "codex  : executor, developer, documenter (écrivent dans le projet) ; reviewer, explorer, debugger, architect, security (lecture seule)."
              echo "claude : architect, debugger, security, reviewer, explorer (lecture seule)."
              echo "Chaque délégation est journalisée ; suivi avec loomy watch." ;;
  esac
}

# Sans argument : l'accueil (état du projet et suite en un choix) dans un terminal, l'aide sinon.
cmd="${1:-home}"; [[ $# -gt 0 ]] && shift

case "$cmd" in
  init|install) exec bash "$S/install-into-project.sh" "$@" ;;
  brief|wizard)
    root="$(project_root)"
    case "${1:-}" in -h|--help) exec bash "$S/init-wizard.sh" --help ;; esac
    if [[ ! -f "$root/.loomy/VERSION" && ! -f "$root/.loomy/brief.md" ]]; then
      echo "Pas de projet Loomy dans ${root/#$HOME/~} : crée-le d'abord avec loomy init." >&2; exit 1
    fi
    exec bash "$S/init-wizard.sh" "$root" "$@" ;;
  start|resume) exec bash "$S/ai-start.sh" --root "$(project_root)" "$@" ;;
  privacy) exec bash "$S/ai-privacy.sh" --root "$(project_root)" "$@" ;;
  route|routing) exec bash "$S/ai-route.sh" --root "$(project_root)" "$@" ;;
  effort) exec bash "$S/ai-effort.sh" --root "$(project_root)" "$@" ;;
  feedback) exec bash "$S/ai-feedback.sh" "$@" ;;
  status) exec bash "$S/ai-status.sh" --root "$(project_root)" "$@" ;;
  doctor) exec bash "$S/ai-doctor.sh" --root "$(project_root)" "$@" ;;
  worktrees) exec bash "$S/create-hybrid-worktrees.sh" "$@" ;;
  delegate)
    case "${1:-}" in -h|--help) sub_help delegate; exit 0 ;; esac
    target="${1:-}"; [[ $# -gt 0 ]] && shift
    case "$target" in
      claude) exec bash "$S/delegate-to-claude.sh" "$@" ;;
      codex) exec bash "$S/delegate-to-codex.sh" "$@" ;;
      *) sub_help delegate >&2; exit 2 ;;
    esac ;;

  watch) exec bash "$S/ai-status.sh" --root "$(project_root)" --watch "$@" ;;

  log|logs)
    case "${1:-}" in -h|--help) sub_help log; exit 0 ;; esac
    exec bash "$S/ai-log.sh" --root "$(project_root)" "$@" ;;

  config)
    sub="${1:-list}"; [[ $# -gt 0 ]] && shift
    case "$sub" in
      -h|--help) sub_help config; exit 0 ;;
      list) echo "# $(loomy_config_file)"; loomy_config_list ;;
      get) loomy_config_get "${1:?clé manquante}" ;;
      set)
        key="${1:?clé manquante}"; val="${2:?valeur manquante}"
        case "$key" in
          plan_claude) [[ "$val" =~ ^(api|pro|max5|max20|team|enterprise)$ ]] || { echo "plan_claude : api, pro, max5, max20, team ou enterprise" >&2; exit 2; } ;;
          plan_codex) [[ "$val" =~ ^(api|plus|pro100|pro200|business|enterprise)$ ]] || { echo "plan_codex : api, plus, pro100, pro200, business ou enterprise" >&2; exit 2; } ;;
          plan_claude_price|plan_codex_price) [[ "$val" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "$key : un prix mensuel en \$" >&2; exit 2; } ;;
          start_watch|notify) [[ "$val" =~ ^(yes|no)$ ]] || { echo "$key : yes ou no" >&2; exit 2; } ;;
          screen) [[ "$val" =~ ^(auto|alt|clear)$ ]] || { echo "screen : auto, alt ou clear" >&2; exit 2; } ;;
          *) echo "Clé inconnue : $key (plan_claude, plan_codex, plan_claude_price, plan_codex_price, start_watch, notify, screen)" >&2; exit 2 ;;
        esac
        loomy_config_set "$key" "$val"; echo "$key=$val" ;;
      *) echo "Usage : loomy config [list | get <clé> | set <clé> <valeur>]" >&2; exit 2 ;;
    esac ;;

  update|upgrade)
    case "${1:-}" in -h|--help) echo "Usage : loomy update [--catalog]"; echo "Met à jour Loomy selon sa méthode d'installation (Homebrew, npm, bun ou script shell)."; echo "--catalog : met à jour seulement le catalogue des modèles et des prix (sans nouvelle version de Loomy)."; exit 0 ;; esac
    if [[ "${1:-}" == "--catalog" ]]; then
      # Catalogue des modèles et des prix, publié dans le dépôt : lu par gh (dépôt privé), sinon par une URL publique.
      tmp="$(mktemp)"
      if ! { command -v gh >/dev/null 2>&1 && gh api -H "Accept: application/vnd.github.raw" "repos/$LOOMY_REPO/contents/catalog/models.conf" >"$tmp" 2>/dev/null; } \
         && ! curl -fsSL "https://raw.githubusercontent.com/$LOOMY_REPO/main/catalog/models.conf" -o "$tmp" 2>/dev/null; then
        rm -f "$tmp"; ui_err "Catalogue introuvable" "vérifie ta connexion et gh auth status"; exit 1
      fi
      newd="$(sed -n 's/^date=\([0-9-]*\)$/\1/p' "$tmp" | head -1)"
      [[ -n "$newd" ]] || { rm -f "$tmp"; ui_err "Catalogue illisible" "aucune date"; exit 1; }
      ui_rail_head "catalogue des modèles"
      if [[ ! "$newd" > "$AI_CATALOG_DATE" ]]; then
        rm -f "$tmp"; ui_ok "Catalogue à jour" "du $AI_CATALOG_DATE ($AI_CATALOG_SOURCE)"; ui_end ""; exit 0
      fi
      old_models="$AI_MODEL_CLAUDE_TOP $AI_MODEL_CLAUDE_MID $AI_MODEL_CLAUDE_FAST $AI_MODEL_CODEX_TOP $AI_MODEL_CODEX_MID $AI_MODEL_CODEX_FAST"
      mkdir -p "$(dirname "$(ai_catalog_file)")"; mv "$tmp" "$(ai_catalog_file)"
      new_models="$(bash -c 'source "$1/lib/models.sh"; echo "$AI_MODEL_CLAUDE_TOP $AI_MODEL_CLAUDE_MID $AI_MODEL_CLAUDE_FAST $AI_MODEL_CODEX_TOP $AI_MODEL_CODEX_MID $AI_MODEL_CODEX_FAST"' _ "$S")"
      ui_ok "Catalogue mis à jour" "du $AI_CATALOG_DATE au $newd"
      if [[ "$old_models" != "$new_models" ]]; then ui_info "modèles routés : $new_models"; ui_info "vérifie qu'ils répondent : loomy doctor --live"; fi
      ui_end "pris en compte par les prochaines sessions et délégations"
      exit 0
    fi
    method="$(install_method)"
    echo "Mise à jour de Loomy (installation : $method)…" >&2
    rc=0
    case "$method" in
      brew)
        # Homebrew télécharge dans un bac à sable sans accès au trousseau macOS : la formule reçoit le jeton de gh.
        if [[ -z "${HOMEBREW_GITHUB_API_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
          HOMEBREW_GITHUB_API_TOKEN="$(gh auth token 2>/dev/null || true)"; export HOMEBREW_GITHUB_API_TOKEN
        fi
        { brew update >/dev/null && brew upgrade eydenn/tap/loomy; } || rc=$? ;;
      bun)
        # bun ne sait pas installer depuis un dépôt GitHub privé : on passe par l'archive de la dernière release.
        tmp="$(mktemp -d "${TMPDIR:-/tmp}/loomy-update.XXXXXX")"
        { gh release download -R "$LOOMY_REPO" -p 'loomy-*.tgz' -D "$tmp" && bun add -g "$tmp"/loomy-*.tgz; } || rc=$?
        rm -rf "$tmp" ;;
      # Même préfixe que l'installation existante, quel que soit le Node actif (nvm).
      npm) npm install -g --prefix "${LOOMY_HOME%/lib/node_modules/*}" "github:$LOOMY_REPO" || rc=$? ;;
      git) git -C "$LOOMY_HOME" pull --ff-only || rc=$? ;;
      *) echo "Méthode d'installation inconnue : réinstallez Loomy (voir README)." >&2; exit 1 ;;
    esac
    if (( rc != 0 )); then
      ui_err "La mise à jour a échoué (code $rc)" "installation détectée : $method · $LOOMY_HOME"
      case "$method" in
        brew) ui_info "à la main : HOMEBREW_GITHUB_API_TOKEN=\"\$(gh auth token)\" brew upgrade eydenn/tap/loomy" ;;
        npm)  ui_info "à la main : npm install -g --prefix ${LOOMY_HOME%/lib/node_modules/*} github:$LOOMY_REPO" ;;
        bun)  ui_info "à la main : gh release download -R $LOOMY_REPO -p 'loomy-*.tgz' -D /tmp/loomy && bun add -g /tmp/loomy/loomy-*.tgz" ;;
        git)  ui_info "à la main : git -C $LOOMY_HOME pull --ff-only" ;;
      esac
      exit "$rc"
    fi
    ui_ok "Loomy à jour" "$(command -v loomy >/dev/null 2>&1 && loomy version || echo "v$VERSION")"
    ui_info "tes projets gardent leur version de Loomy : dans chacun, loomy init --update les met à niveau"
    if (( $(loomy_installs | wc -l) > 1 )); then ui_section "INSTALLATIONS"; show_installs; fi
    ;;

  __home) echo "$LOOMY_HOME" ;;   # utilisé par les relais des projets (.loomy/scripts/_loomy.sh)

  version|--version|-v)
    echo "loomy $VERSION ($(install_method) · $LOOMY_HOME)"
    if [[ "${1:-}" == "--all" ]]; then show_installs
    elif (( $(loomy_installs | wc -l) > 1 )); then echo "Plusieurs installations de loomy dans le PATH : loomy version --all" >&2; fi ;;
  home)
    if [[ -t 0 && -t 2 ]]; then exec bash "$S/ai-home.sh"; fi
    usage ;;
  help|--help|-h)
    # loomy help <commande> : aide de cette commande.
    if [[ -n "${1:-}" && "$1" != "help" ]]; then exec "$LOOMY_HOME/bin/loomy" "$1" --help; fi
    usage ;;
  uninstall)
    ui_banner "Désinstaller Loomy" "rien n'est supprimé automatiquement"
    ui_section "INSTALLATIONS" "une commande par installation trouvée"
    n=0
    while IFS=$'\t' read -r m h p; do
      [[ -n "$m" ]] || continue; n=$(( n + 1 ))
      ui_rail "${C_BOLD}$m${C_RESET} ${C_DIM}${h/#$HOME/~}${C_RESET}"
      ui_rail "    $(uninstall_cmd "$m" "$h" "$p")"
    done < <(loomy_installs)
    if (( n == 0 )); then ui_rail "$(install_method) ${C_DIM}${LOOMY_HOME/#$HOME/~}${C_RESET}"; ui_rail "    $(uninstall_cmd "$(install_method)" "$LOOMY_HOME" "$INVOKED")"; fi
    ui_section "DANS TES PROJETS"
    ui_rail "Chaque projet garde son dossier ${C_BOLD}.loomy/${C_RESET} : l'orchestrateur s'en sert pour déléguer et suivre les phases."
    ui_rail "Pour retirer Loomy d'un projet : ${C_BOLD}rm -rf .loomy START.md${C_RESET} ${C_DIM}(et la ligne .loomy/logs/ du .gitignore)${C_RESET}"
    ui_rail "${C_DIM}Configuration personnelle : $(loomy_config_file | sed "s|^$HOME|~|")${C_RESET}"
    ui_end "lance la commande qui correspond à ton installation"
    ;;
  *) echo "Commande inconnue : $cmd" >&2; usage >&2; exit 2 ;;
esac
