#!/usr/bin/env bash
# Claude Code CLI test double for tests/run.sh: no network request.
#   STUB_SLEEP=N              waits N seconds before answering
#   STUB_BROKEN_VERSION=1     "claude --version" fails
#   STUB_LOG=file             records each call (tab-separated arguments)
#   STUB_UNKNOWN_MODELS="…"   refuses those model ids (a model not released yet)
#   STUB_ARGV_LOG=file        records the exact argument array as JSON
#   STUB_RESULT_FILE=file    returns this verbatim result (also in structured mode)
set -u
if [[ -n "${STUB_ARGV_LOG:-}" ]]; then perl -MJSON::PP -e 'print encode_json(\@ARGV)' -- "$@" >"$STUB_ARGV_LOG"; fi
if [[ -n "${STUB_LOG:-}" ]]; then (IFS=$'\t'; printf 'claude\t%s\n' "$*") >>"$STUB_LOG"; fi
case "${1:-}" in
  --version)
    [[ -n "${STUB_BROKEN_VERSION:-}" ]] && exit 1
    echo "2.1.300 (Claude Code)"; exit 0 ;;
  update) echo "Claude Code is up to date."; exit 0 ;;
esac
stub_sleep_pid=""
if [[ -n "${STUB_SLEEP:-}" ]]; then
  trap '[[ -z "$stub_sleep_pid" ]] || { kill "$stub_sleep_pid" 2>/dev/null || true; wait "$stub_sleep_pid" 2>/dev/null || true; }; exit 143' TERM
fi
[[ -z "${STUB_PID_FILE:-}" ]] || printf '%s\n' "$$" >"$STUB_PID_FILE"
if [[ -n "${STUB_SLEEP:-}" ]]; then
  sleep "$STUB_SLEEP" &
  stub_sleep_pid=$!
  wait "$stub_sleep_pid"
fi
if [[ -n "${STUB_CLAUDE_RESULT_ERROR:-}" ]]; then
  printf '%s' "$STUB_CLAUDE_RESULT_ERROR" | perl -MJSON::PP -0777 -ne 'print encode_json({type=>"result",is_error=>JSON::PP::true,result=>$_}),"\n"'
  exit "${STUB_CLAUDE_ERROR_EXIT:-0}"
fi
if [[ -n "${STUB_CLAUDE_ERROR:-}" ]]; then printf '%s\n' "$STUB_CLAUDE_ERROR" >&2; exit 1; fi
# STUB_UNKNOWN_MODELS="a b": those model ids are refused, like a model not released yet.
for m in ${STUB_UNKNOWN_MODELS:-}; do
  case " $* " in *" --model $m "*) printf '{"type":"result","subtype":"error","is_error":true,"result":"model not found: %s"}\n' "$m"; exit 1 ;; esac
done
text="${STUB_CLAUDE_TEXT:-answer from the claude double}"
case "$*" in *"Reply exactly: OK"*) text="OK" ;; esac
# Structured delegation asked: answer with the contract's fields (newlines escaped for the JSON output).
case "$*" in *"STATUS: done | partial | blocked"*) text='STATUS: blocked\nSUMMARY: answer from the claude double\nFINDINGS:\n- none\nFILES:\n- none\nCHECKS:\n- none\nRISKS:\n- missing access\nNEXT: grant access' ;; esac
if [[ -n "${STUB_RESULT_FILE:-}" ]]; then
  text="$(perl -MJSON::PP -MEncode=decode -0777 -ne 'print substr(encode_json([decode("UTF-8",$_)]),2,-2)' "$STUB_RESULT_FILE")"
fi
printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","total_cost_usd":0.0123,"usage":{"input_tokens":120,"cache_creation_input_tokens":0,"cache_read_input_tokens":80,"output_tokens":40}}\n' "$text"
