#!/usr/bin/env bash
# gh test double for tests/run.sh: "testeur" account, repositories created locally, no network call.
#   GH_STUB_REMOTES=folder    where to create the repositories (tests redirect https://github.com/ there with git insteadOf)
#   STUB_LOG=fichier          note chaque appel
set -u
if [[ -n "${STUB_LOG:-}" ]]; then (IFS=$'\t'; printf 'gh\t%s\n' "$*") >>"$STUB_LOG"; fi
case "${1:-} ${2:-}" in
  "auth status") exit 0 ;;
  "auth token") echo "jeton-de-test" ;;
  "api user") echo "testeur" ;;
  "repo view")
    d="${GH_STUB_REMOTES:-/nonexistent}/${3:-}.git"
    [[ -n "${3:-}" && -d "$d" ]] || exit 1
    case "$*" in
      *isEmpty*) printf 'PRIVATE %s\n' "$(git --git-dir="$d" rev-parse -q --verify HEAD >/dev/null && echo false || echo true)" ;;
      *--json*) echo PRIVATE ;;
    esac
    exit 0 ;;
  "repo create")
    name="${3:-}"; [[ "$name" == */* ]] || name="testeur/$name"
    remote=""; source_dir=""
    for a in "$@"; do case "$a" in --remote=*) remote="${a#--remote=}" ;; --source=*) source_dir="${a#--source=}" ;; esac; done
    [[ -n "${GH_STUB_REMOTES:-}" ]] && mkdir -p "$GH_STUB_REMOTES/$(dirname "$name")" && git init --bare -q -b main "$GH_STUB_REMOTES/$name.git"
    if [[ -n "$remote" && -n "$source_dir" ]]; then git -C "$source_dir" remote add "$remote" "https://github.com/$name.git"; fi
    echo "https://github.com/$name" ;;
  "issue list")
    # GH_STUB_ISSUES=file: what the --jq query would print (one formatted line per issue).
    [[ -n "${GH_STUB_ISSUES:-}" && -f "$GH_STUB_ISSUES" ]] && cat "$GH_STUB_ISSUES"
    exit 0 ;;
  "api repos/"*) case "$*" in *permissions.push*) echo "${GH_STUB_PUSH:-true}" ;; esac; exit 0 ;;
  *) exit 0 ;;
esac
