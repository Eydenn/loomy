#!/usr/bin/env bash
set -eu
case "${1:-}" in
  --version)
    printf 'claude\t--version\n' >>"$STUB_LOG"
    printf '%s (Claude Code)\n' "${STUB_APP_VERSION:-2.1.300}"
    exit 0 ;;
  --desktop)
    printf 'claude'; printf '\t%s' "$@"; printf '\n'
    exit "${STUB_DESKTOP_FAIL:-0}" ;;
esac
[[ -z "${STUB_ONLY_OUT:-}" ]] || bash "$STUB_ONLY_REPO/tests/fixtures/session-only.sh"
exec "$LOOMY_TEST_ORIGINAL_STUBS/claude" "$@"
