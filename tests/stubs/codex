#!/usr/bin/env bash
# Codex CLI test double for tests/run.sh: no network request.
#   STUB_FAIL=1    codex exec fails
#   STUB_WRITE=1   in the workspace-write sandbox, creates a file in the working folder
#   STUB_SLEEP=N   waits N seconds before answering
#   STUB_LOG=file  records each call (tab-separated arguments)
set -u
if [[ -n "${STUB_LOG:-}" ]]; then (IFS=$'\t'; printf 'codex\t%s\n' "$*") >>"$STUB_LOG"; fi
# Interactive session (without exec subcommand): nothing to simulate.
case "${1:-}" in exec|--version) ;; *) exit 0 ;; esac
if [[ "${1:-}" == "--version" ]]; then echo "codex-cli 0.160.0"; exit 0; fi
[[ "${1:-}" == "exec" ]] || { echo "codex double: unsupported command: $*" >&2; exit 2; }
shift
stub_sleep_pid=""
if [[ -n "${STUB_SLEEP:-}" ]]; then
  trap '[[ -z "$stub_sleep_pid" ]] || { kill "$stub_sleep_pid" 2>/dev/null || true; wait "$stub_sleep_pid" 2>/dev/null || true; }; exit 143' TERM
fi
[[ -z "${STUB_PID_FILE:-}" ]] || printf '%s\n' "$$" >"$STUB_PID_FILE"
if [[ -n "${STUB_SLEEP:-}" ]]; then
  sleep "$STUB_SLEEP" &
  stub_sleep_pid=$!
  wait "$stub_sleep_pid"
fi
out=""; dir="."; sandbox="read-only"; prompt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift ;;
    -C) dir="$2"; shift ;;
    -s) sandbox="$2"; shift ;;
    -m|-c) shift ;;
    --*) ;;
    *) prompt="$1" ;;
  esac
  shift
done
if [[ -n "${STUB_FAIL:-}" ]]; then echo '{"type":"error","message":"simulated failure"}'; exit 1; fi
text="answer from the codex double"
case "$prompt" in *"Reply exactly: OK"*) text="OK" ;; esac
# Structured delegation asked: answer with the contract's fields.
case "$prompt" in *"STATUS: done | partial | blocked"*) text="$(printf 'STATUS: partial\nSUMMARY: answer from the codex double\nFINDINGS:\n- [low] a.txt:1 — stub\nFILES:\n- none\nCHECKS:\n- `true` — passed\nRISKS:\n- none\nNEXT: finish it')" ;; esac
if [[ -n "${STUB_WRITE:-}" && "$sandbox" == "workspace-write" ]]; then echo "written by the double" >"$dir/fichier_doublure.txt"; fi
echo '{"type":"thread.started","thread_id":"stub"}'
echo '{"type":"turn.completed","usage":{"input_tokens":1000,"cached_input_tokens":400,"output_tokens":200}}'
[[ -n "$out" ]] && printf '%s\n' "$text" >"$out"
exit 0
