#!/usr/bin/env bash
# Doublure de la CLI Codex pour tests/run.sh : aucune requête réseau.
#   STUB_FAIL=1    codex exec échoue
#   STUB_WRITE=1   en sandbox workspace-write, crée un fichier dans le dossier de travail
#   STUB_LOG=fichier  note chaque appel (arguments séparés par des tabulations)
set -u
if [[ -n "${STUB_LOG:-}" ]]; then (IFS=$'\t'; printf 'codex\t%s\n' "$*") >>"$STUB_LOG"; fi
# Session interactive (sans sous-commande exec) : rien à simuler.
case "${1:-}" in exec|--version) ;; *) exit 0 ;; esac
if [[ "${1:-}" == "--version" ]]; then echo "codex-cli 0.160.0"; exit 0; fi
[[ "${1:-}" == "exec" ]] || { echo "doublure codex : commande non prise en charge : $*" >&2; exit 2; }
shift
out=""; dir="."; sandbox="read-only"; prompt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift ;;
    -C) dir="$2"; shift ;;
    -s) sandbox="$2"; shift ;;
    -m|-c) shift ;;
    --*) ;;
    *) prompt="$1" ;;
  esac
  shift
done
if [[ -n "${STUB_FAIL:-}" ]]; then echo '{"type":"error","message":"échec simulé"}'; exit 1; fi
text="réponse de la doublure codex"
case "$prompt" in *"Réponds exactement : OK"*) text="OK" ;; esac
if [[ -n "${STUB_WRITE:-}" && "$sandbox" == "workspace-write" ]]; then echo "écrit par la doublure" >"$dir/fichier_doublure.txt"; fi
echo '{"type":"thread.started","thread_id":"stub"}'
echo '{"type":"turn.completed","usage":{"input_tokens":1000,"cached_input_tokens":400,"output_tokens":200}}'
[[ -n "$out" ]] && printf '%s\n' "$text" >"$out"
exit 0
