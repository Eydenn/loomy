#!/usr/bin/env bash
# loomy — Loomy's single entry point. Bash 3.2 compatible.
# Installed via npm, bun, Homebrew or install.sh; they all point to this file.
set -euo pipefail

# Real install folder (symlinks created by npm, bun or Homebrew are resolved).
_realpath() {
  local p="$1" link
  while [[ -L "$p" ]]; do
    link="$(readlink "$p")"
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
}
LOOMY_HOME="$(cd "$(dirname "$(_realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
S="$LOOMY_HOME/scripts"
LOOMY_REPO="${LOOMY_REPO:-Eydenn/loomy}"
VERSION="$(cat "$LOOMY_HOME/VERSION" 2>/dev/null || echo "?")"

# shellcheck source=../scripts/lib/ui.sh
source "$S/lib/ui.sh"
# shellcheck source=../scripts/lib/config.sh
source "$S/lib/config.sh"

# shellcheck source=../scripts/lib/models.sh
source "$S/lib/models.sh"
project_root() { ai_project_root; }

INVOKED="${BASH_SOURCE[0]}"

# ---------------------------------------------------------------- installations
# method_of <invoked path> <real folder>: brew, npm, bun, git (clone + install.sh) or manual.
# Order matters: npm installed with Homebrew's Node stores its packages in /opt/homebrew/lib/node_modules,
# and bun may store its own in ~/node_modules (bun is then recognised by the invoked path, ~/.bun/bin).
method_of() {
  case "$1" in */.bun/*) echo "bun"; return 0 ;; esac
  case "$2" in
    */.bun/*|*/install/global/node_modules/*) echo "bun" ;;
    */node_modules/*) echo "npm" ;;
    */Cellar/*) echo "brew" ;;
    *) if [[ -d "$2/.git" ]]; then echo "git"; else echo "manuel"; fi ;;
  esac
}
install_method() { method_of "$INVOKED" "$LOOMY_HOME"; }

# home_of <loomy executable>: real install folder (resolved link, or target of the small install.sh script).
home_of() {
  local p="$1" t
  if [[ ! -L "$p" ]] && grep -qE "Install(é par|ed by) install.sh (de|of) Loomy" "$p" 2>/dev/null; then
    t="$(sed -n 's/^exec "\(.*\)\/bin\/loomy" .*/\1/p' "$p" | head -1)"
    if [[ -n "$t" ]]; then echo "$t"; return 0; fi
  fi
  (cd "$(dirname "$(_realpath "$p")")/.." 2>/dev/null && pwd)
}

# loomy_installs: "method<TAB>folder<TAB>command" for each loomy in the PATH, in PATH order.
loomy_installs() {
  local p h seen=" "
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    h="$(home_of "$p")" || continue
    case "$seen" in *" $h "*) continue ;; esac
    seen="$seen$h "
    printf '%s\t%s\t%s\n' "$(method_of "$p" "$h")" "$h" "$p"
  done < <(type -ap loomy 2>/dev/null || true)
}

uninstall_cmd() {
  case "$1" in
    brew) echo "brew uninstall eydenn/tap/loomy" ;; npm) echo "npm uninstall -g loomy" ;;
    bun) echo "bun remove -g loomy" ;;
    *)
      # The command found in the PATH is the clone's own bin/loomy: removing it would damage the clone.
      if [[ "$(cd "$(dirname "$3")" 2>/dev/null && pwd -P)/$(basename "$3")" == "$(cd "$2" 2>/dev/null && pwd -P)/bin/loomy" ]]; then t "remove %s from your PATH" "$2/bin"
      elif [[ -f "$2/install.sh" ]]; then echo "sh $2/install.sh --uninstall"
      else echo "rm $3"; fi ;;
  esac
}

# show_installs: the install in use, then the other copies found in the PATH and how to remove them.
show_installs() {
  local m h p v n=0 first=1
  while IFS=$'\t' read -r m h p; do
    [[ -n "$m" ]] || continue
    n=$(( n + 1 ))
    v="$(cat "$h/VERSION" 2>/dev/null || echo "?")"
    if [[ "$h" == "$LOOMY_HOME" ]]; then
      ui_ok "$m v$v" "${h/#$HOME/~} · $( (( first )) && t "used by the loomy command" || t "hidden by another one in the PATH")"
    else
      ui_warn "$m v$v" "${h/#$HOME/~} · $(t "other install")$( (( first )) && echo ", $(t "used by the loomy command")")"
      ui_rail "    ${C_DIM}$(t "to remove it:")${C_RESET} $(uninstall_cmd "$m" "$h" "$p")"
    fi
    first=0
  done < <(loomy_installs)
  if (( n == 0 )); then ui_warn "$(t "loomy not in the PATH")" "$(t "install: see the README")"; fi
  if (( n > 1 )); then ui_info "$(t "several installs: keep only one to avoid mixed versions")"; fi
  return 0
}

# ---------------------------------------------------------------- aide
# Help goes to standard output (loomy help | less), in colour only to a terminal.
_h_color() {
  if [[ ( -t 1 || -n "${LOOMY_FORCE_COLOR:-}" ) && -z "${NO_COLOR:-}" ]]; then
    HB="$C_BOLD"; HD="$C_DIM"; HR="$C_RESET"; HL="$C_RAIL"; HA="$C_BOX"
  else
    HB=""; HD=""; HR=""; HL=""; HA=""; C_BOLD=""; C_DIM=""; C_RESET=""; C_RAIL=""; C_BRAND=""
  fi
}
_h_group() { printf '%s\n%s◇%s  %s%s%s\n' "${HL}│${HR}" "$HL" "$HR" "$HB" "$1" "$HR"; }
# _h_cmd <command> <arguments> <description>: aligned command column, description wrapped to the terminal width.
_h_cmd() {
  local left="loomy $1${2:+ $2}" col=34 len i indent
  _ui_term_size
  _ui_strlen "$left"; len=$UI_LEN
  # Two columns from 80 columns; otherwise the description goes under the command.
  if (( UI_COLS >= 80 && len + 2 <= col )); then
    _ui_wrap "$3" $(( UI_COLS - col - 5 ))
    _ui_pad "$left" "$col"
    printf '%s│%s  %sloomy%s %s%s%s%s%s\n' "$HL" "$HR" "$HD" "$HR" "$HB" "$1" "$HR" "${2:+ ${HA}$2${HR}}" "${UI_PADDED:${#left}}${UI_LINES[0]:-}"
    indent=$col
  else
    printf '%s│%s  %sloomy%s %s%s%s%s\n' "$HL" "$HR" "$HD" "$HR" "$HB" "$1" "$HR" "${2:+ ${HA}$2${HR}}"
    if (( UI_COLS >= 80 )); then indent=$col; else indent=4; fi
    _ui_wrap "$3" $(( UI_COLS - indent - 5 ))
    _ui_pad "" "$indent"; printf '%s│%s  %s%s\n' "$HL" "$HR" "$UI_PADDED" "${UI_LINES[0]:-}"
  fi
  _ui_pad "" "$indent"
  for (( i = 1; i < ${#UI_LINES[@]}; i++ )); do printf '%s│%s  %s%s\n' "$HL" "$HR" "$UI_PADDED" "${UI_LINES[$i]}"; done
  return 0
}

usage() {
  _h_color
  if [[ -n "${LOOMY_NO_HEADER:-}" ]]; then :
  elif [[ -t 1 ]] && ui_logo_ok; then
    _ui_logo_lines "  "; printf '\n'; printf '%s\n' "${UI_LINES[@]}"
  else
    printf '\n  %sLoomy%s\n' "$C_BRAND" "$HR"
  fi
  local tag="v$VERSION" l pad item
  printf '\n  %s%s%s  %s%s%s\n' "$HB" "$tag" "$HR" "$HB" "$(t "Starts and structures your projects with Codex and Claude Code")" "$HR"
  _ui_pad "" $(( ${#tag} + 4 )); pad="$UI_PADDED"
  _ui_term_size
  # Wrap between items (never in the middle of one).
  l=""
  for item in "$(t "questionnaire")" "$(t "agent-ready structure")" "$(t "lead agent and dedicated roles")" "$(t "live tracking")"; do
    if [[ -n "$l" ]] && (( ${#l} + ${#item} + 3 > UI_COLS - ${#pad} - 2 )); then printf '%s%s%s%s\n' "$pad" "$HD" "$l" "$HR"; l=""; fi
    l="${l:+$l · }$item"
  done
  printf '%s%s%s%s\n' "$pad" "$HD" "$l" "$HR"
  printf '\n'
  printf '%s┌%s  %s%s%s\n' "$HL" "$HR" "$HD" "$(t "Usage: loomy <command> [arguments] · loomy alone: project home")" "$HR"
  _h_group "$(t "PROJECT")"
  _h_cmd init "$(t "[folder] [options]")" "$(t "Creates or sets up a project, new or existing (offers to create the folder from the project name): questionnaire, then structure set up by the lead agent. Project already set up: resume, --update, --reset")"
  _h_cmd brief "" "$(t "Runs the current project's questionnaire again")"
  _h_cmd assess "[--print]" "$(t "Assessment of an existing project, without AI: stack, commands, tests, CI, conventions, Git history, sensitive areas, debt (.loomy/assessment.md)")"
  _h_cmd start "[--resume|--new|--print] [--watch]" "$(t "Starts or resumes the lead agent session, at the right point of the project (session closed? it's here); --watch opens live tracking alongside")"
  _h_cmd effort "$(t "[<role>] [level|--reset]")" "$(t "Reasoning effort of the lead agent (or a role) for this project: low, medium, high, xhigh, max")"
  _h_cmd route "$(t "[command]")" "$(t "Role → model → effort matrix (lead, get <role>, markdown, all, claude-agents, codex-profiles)")"
  _h_cmd delegate "$(t "<claude|codex> <role> \"task\"")" "$(t "Hands a role to Claude or Codex through the bridges")"
  _h_cmd privacy "[mode|sync|restore]" "$(t "AI files visibility: versioned, local, or in a separate private repository")"
  _h_cmd worktrees "$(t "<task> [base]")" "$(t "Creates two separate worktrees for parallel mode")"
  _h_group "$(t "TRACKING")"
  _h_cmd status "" "$(t "Project status: phases, running delegations, activity, costs, Git")"
  _h_cmd watch "[N]" "$(t "Live tracking (keys: q, c view, l log, s session)")"
  _h_cmd stats "[--days N|--since D]" "$(t "Detailed statistics: delegations by role, model and day, durations, tokens, cost (or quota with a subscription)")"
  _h_cmd log "[-n N] [-f] [--raw]" "$(t "Readable log of phases, delegations and sessions (--raw: JSON)")"
  _h_cmd feedback "[\"message\"]" "$(t "Reports a bug or an idea: prefilled GitHub issue (versions, anonymized project state), sent only after your approval")"
  _h_group "$(t "MACHINE")"
  _h_cmd doctor "[--fix] [--live]" "$(t "Checks the prerequisites; --fix fixes, --live tests every model")"
  _h_cmd config "[list|get|set]" "$(t "Preferences: Claude and Codex plans")"
  _h_cmd update "[--catalog]" "$(t "Updates Loomy according to its install method; --catalog: only the model and price catalog")"
  _h_cmd version "[--all]" "$(t "Version and install method; --all lists every install found")"
  _h_cmd uninstall "" "$(t "Shows how to uninstall Loomy (depending on the install) and remove it from a project")"
  printf '%s│%s\n%s└%s  %s%s%s\n\n' "$HL" "$HR" "$HL" "$HR" "$HD" "$(t "Help for a command: loomy help <command>")" "$HR"
}

# Short help for the commands handled directly here.
sub_help() {
  case "$1" in
    log) t "Usage: loomy log [-n N] [-f] [--raw] [--since YYYY-MM-DD] [--csv]"; echo; t "Shows the last N log events (20 by default), readable and in local time; -f follows it live; --raw gives the raw JSON lines (.loomy/logs/events.jsonl)."; echo ;;
    config) t "Usage: loomy config [list | get <key> | set <key> <value>]"; echo
            t "Keys: plan_claude (api, pro, max5, max20, team, enterprise), plan_codex (api, plus, pro100, pro200, business, enterprise),"; echo
            t "      plan_claude_price, plan_codex_price (monthly price in \$ if different from the list price),"; echo
            t "      quota_switch (95 by default: from this share of a subscription quota, work moves to the other tool; off: never),"; echo
            t "      delegation_format (structured or free: overrides every project's choice; auto: the project's choice),"; echo
            t "      start_watch (yes: loomy start also opens live tracking next to the session),"; echo
            t "      notify (no: loomy watch no longer notifies phase changes, failures and end of bootstrap),"; echo
            t "      screen (alt: separate screen; clear: screen and history cleared, for terminals without a separate screen; auto),"; echo
            t "      model.<claude|codex>.<top|mid|fast> (pins a model on this machine; auto: catalog's choice),"; echo
            t "      lang (fr or en: interface language; auto: system language, English by default)."; echo
            t "File: %s" "$(loomy_config_file)"; echo ;;
    delegate) t "Usage: loomy delegate <claude|codex> <role> \"task\""; echo
              t "codex : executor, developer, documenter (write in the project); reviewer, explorer, debugger, architect, security (read-only)."; echo
              t "claude: architect, debugger, security, reviewer, explorer (read-only)."; echo
              t "Every delegation is logged; track it with loomy watch."; echo ;;
  esac
}

# No argument: the home screen (project status and next step in one choice) in a terminal, help otherwise.
cmd="${1:-home}"; [[ $# -gt 0 ]] && shift

case "$cmd" in
  init|install) exec bash "$S/install-into-project.sh" "$@" ;;
  brief|wizard)
    root="$(project_root)"
    case "${1:-}" in -h|--help) exec bash "$S/init-wizard.sh" --help ;; esac
    if [[ ! -f "$root/.loomy/VERSION" && ! -f "$root/.loomy/brief.md" ]]; then
      t "No Loomy project in %s: create it first with loomy init." "${root/#$HOME/~}" >&2; echo >&2; exit 1
    fi
    exec bash "$S/init-wizard.sh" "$root" "$@" ;;
  start|resume) exec bash "$S/ai-start.sh" --root "$(project_root)" "$@" ;;
  privacy) exec bash "$S/ai-privacy.sh" --root "$(project_root)" "$@" ;;
  route|routing) exec bash "$S/ai-route.sh" --root "$(project_root)" "$@" ;;
  effort) exec bash "$S/ai-effort.sh" --root "$(project_root)" "$@" ;;
  feedback) exec bash "$S/ai-feedback.sh" "$@" ;;
  status) exec bash "$S/ai-status.sh" --root "$(project_root)" "$@" ;;
  assess) exec bash "$S/ai-assess.sh" --root "$(project_root)" "$@" ;;
  stats) exec bash "$S/ai-stats.sh" --root "$(project_root)" "$@" ;;
  doctor) exec bash "$S/ai-doctor.sh" --root "$(project_root)" "$@" ;;
  worktrees) exec bash "$S/create-hybrid-worktrees.sh" "$@" ;;
  delegate)
    case "${1:-}" in -h|--help) sub_help delegate; exit 0 ;; esac
    target="${1:-}"; [[ $# -gt 0 ]] && shift
    case "$target" in
      claude) exec bash "$S/delegate-to-claude.sh" "$@" ;;
      codex) exec bash "$S/delegate-to-codex.sh" "$@" ;;
      *) sub_help delegate >&2; exit 2 ;;
    esac ;;

  watch) exec bash "$S/ai-status.sh" --root "$(project_root)" --watch "$@" ;;

  log|logs)
    case "${1:-}" in -h|--help) sub_help log; exit 0 ;; esac
    exec bash "$S/ai-log.sh" --root "$(project_root)" "$@" ;;

  config)
    sub="${1:-list}"; [[ $# -gt 0 ]] && shift
    case "$sub" in
      -h|--help) sub_help config; exit 0 ;;
      list) echo "# $(loomy_config_file)"; loomy_config_list ;;
      get) loomy_config_get "${1:?missing key}" ;;
      set)
        key="${1:?missing key}"; val="${2:?missing value}"
        case "$key" in
          plan_claude) [[ "$val" =~ ^(api|pro|max5|max20|team|enterprise)$ ]] || { t "plan_claude: api, pro, max5, max20, team or enterprise" >&2; echo >&2; exit 2; } ;;
          plan_codex) [[ "$val" =~ ^(api|plus|pro100|pro200|business|enterprise)$ ]] || { t "plan_codex: api, plus, pro100, pro200, business or enterprise" >&2; echo >&2; exit 2; } ;;
          plan_claude_price|plan_codex_price) [[ "$val" =~ ^[0-9]+([.][0-9]+)?$ ]] || { t "%s: a monthly price in \$" "$key" >&2; echo >&2; exit 2; } ;;
          start_watch|notify) [[ "$val" =~ ^(yes|no)$ ]] || { t "%s: yes or no" "$key" >&2; echo >&2; exit 2; } ;;
          quota_switch) [[ "$val" == "off" || ( "$val" =~ ^[0-9]+$ && "$val" -ge 1 && "$val" -le 100 ) ]] || { t "quota_switch: a percentage (1 to 100) or off" >&2; echo >&2; exit 2; } ;;
          delegation_format) [[ "$val" =~ ^(auto|structured|free)$ ]] || { t "delegation_format: structured, free or auto (the project's choice)" >&2; echo >&2; exit 2; } ;;
          lang) [[ "$val" =~ ^(auto|fr|en)$ ]] || { t "lang: auto, fr or en" >&2; echo >&2; exit 2; } ;;
          screen) [[ "$val" =~ ^(auto|alt|clear)$ ]] || { t "screen: auto, alt or clear" >&2; echo >&2; exit 2; } ;;
          model.claude.top|model.claude.mid|model.claude.fast|model.codex.top|model.codex.mid|model.codex.fast)
            [[ "$val" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { t "%s: a model id, or auto (catalog's choice)" "$key" >&2; echo >&2; exit 2; } ;;
          *) t "Unknown key: %s (%s)" "$key" "plan_claude, plan_codex, plan_claude_price, plan_codex_price, quota_switch, delegation_format, start_watch, notify, screen, lang, model.<claude|codex>.<top|mid|fast>" >&2; echo >&2; exit 2 ;;
        esac
        loomy_config_set "$key" "$val"; echo "$key=$val" ;;
      *) t "Usage: loomy config [list | get <key> | set <key> <value>]" >&2; echo >&2; exit 2 ;;
    esac ;;

  update|upgrade)
    case "${1:-}" in -h|--help) t "Usage: loomy update [--catalog]"; echo; t "Updates Loomy according to its install method (Homebrew, npm, bun or shell script)."; echo; t "--catalog: only updates the model and price catalog (no new Loomy version)."; echo; exit 0 ;; esac
    if [[ "${1:-}" == "--catalog" ]]; then
      # Model and price catalog, published in the repository: read with gh (private repository), otherwise via a public URL.
      tmp="$(mktemp)"
      if ! { command -v gh >/dev/null 2>&1 && gh api -H "Accept: application/vnd.github.raw" "repos/$LOOMY_REPO/contents/catalog/models.conf" >"$tmp" 2>/dev/null; } \
         && ! curl -fsSL "https://raw.githubusercontent.com/$LOOMY_REPO/main/catalog/models.conf" -o "$tmp" 2>/dev/null; then
        rm -f "$tmp"; ui_err "$(t "Catalog not found")" "$(t "check your connection and gh auth status")"; exit 1
      fi
      newd="$(sed -n 's/^date=\([0-9-]*\)$/\1/p' "$tmp" | head -1)"
      [[ -n "$newd" ]] || { rm -f "$tmp"; ui_err "$(t "Unreadable catalog")" "$(t "no date")"; exit 1; }
      ui_rail_head "$(t "model catalog")"
      if [[ ! "$newd" > "$AI_CATALOG_DATE" ]]; then
        rm -f "$tmp"; ui_ok "$(t "Catalog up to date")" "$(t "from %s" "$AI_CATALOG_DATE") ($(t "$AI_CATALOG_SOURCE"))"; ui_end ""; exit 0
      fi
      old_models="$AI_MODEL_CLAUDE_TOP $AI_MODEL_CLAUDE_MID $AI_MODEL_CLAUDE_FAST $AI_MODEL_CODEX_TOP $AI_MODEL_CODEX_MID $AI_MODEL_CODEX_FAST"
      mkdir -p "$(dirname "$(ai_catalog_file)")"; mv "$tmp" "$(ai_catalog_file)"
      new_models="$(bash -c 'source "$1/lib/models.sh"; echo "$AI_MODEL_CLAUDE_TOP $AI_MODEL_CLAUDE_MID $AI_MODEL_CLAUDE_FAST $AI_MODEL_CODEX_TOP $AI_MODEL_CODEX_MID $AI_MODEL_CODEX_FAST"' _ "$S")"
      ui_ok "$(t "Catalog updated")" "$(t "from %s to %s" "$AI_CATALOG_DATE" "$newd")"
      if [[ "$old_models" != "$new_models" ]]; then ui_info "$(t "routed models: %s" "$new_models")"; ui_info "$(t "check that they answer: loomy doctor --live")"; fi
      ui_end "$(t "applied to the next sessions and delegations")"
      exit 0
    fi
    method="$(install_method)"
    t "Updating Loomy (install: %s)…" "$method" >&2; echo >&2
    rc=0
    case "$method" in
      brew)
        # Homebrew downloads in a sandbox without access to the macOS keychain: the formula gets gh's token.
        if [[ -z "${HOMEBREW_GITHUB_API_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
          HOMEBREW_GITHUB_API_TOKEN="$(gh auth token 2>/dev/null || true)"; export HOMEBREW_GITHUB_API_TOKEN
        fi
        { brew update >/dev/null && brew upgrade eydenn/tap/loomy; } || rc=$? ;;
      bun)
        # bun can't install from a private GitHub repository: we go through the latest release archive.
        tmp="$(mktemp -d "${TMPDIR:-/tmp}/loomy-update.XXXXXX")"
        { gh release download -R "$LOOMY_REPO" -p 'loomy-*.tgz' -D "$tmp" && bun add -g "$tmp"/loomy-*.tgz; } || rc=$?
        rm -rf "$tmp" ;;
      # Same prefix as the existing install, whatever Node is active (nvm).
      # The latest release, not the tip of main (which may hold unreleased work).
      npm) tag="$(gh release view -R "$LOOMY_REPO" --json tagName -q .tagName 2>/dev/null || true)"
           npm install -g --prefix "${LOOMY_HOME%/lib/node_modules/*}" "github:$LOOMY_REPO${tag:+#$tag}" || rc=$? ;;
      git) git -C "$LOOMY_HOME" pull --ff-only || rc=$? ;;
      *) t "Unknown install method: reinstall Loomy (see README)." >&2; echo >&2; exit 1 ;;
    esac
    if (( rc != 0 )); then
      ui_err "$(t "The update failed (code %s)" "$rc")" "$(t "detected install: %s" "$method · $LOOMY_HOME")"
      case "$method" in
        brew) ui_info "$(t "by hand:") HOMEBREW_GITHUB_API_TOKEN=\"\$(gh auth token)\" brew upgrade eydenn/tap/loomy" ;;
        npm)  ui_info "$(t "by hand:") npm install -g --prefix ${LOOMY_HOME%/lib/node_modules/*} github:$LOOMY_REPO" ;;
        bun)  ui_info "$(t "by hand:") gh release download -R $LOOMY_REPO -p 'loomy-*.tgz' -D /tmp/loomy && bun add -g /tmp/loomy/loomy-*.tgz" ;;
        git)  ui_info "$(t "by hand:") git -C $LOOMY_HOME pull --ff-only" ;;
      esac
      exit "$rc"
    fi
    ui_ok "$(t "Loomy up to date")" "$(command -v loomy >/dev/null 2>&1 && loomy version || echo "v$VERSION")"
    ui_info "$(t "your projects use this version right away; loomy init --update is only for new document templates")"
    if (( $(loomy_installs | wc -l) > 1 )); then ui_section "$(t "INSTALLS")"; show_installs; fi
    ;;

  __home) echo "$LOOMY_HOME" ;;   # used by the project relays (.loomy/scripts/_loomy.sh)

  version|--version|-v)
    echo "loomy $VERSION ($(install_method) · $LOOMY_HOME)"
    if [[ "${1:-}" == "--all" ]]; then show_installs
    elif (( $(loomy_installs | wc -l) > 1 )); then t "Several loomy installs in the PATH: loomy version --all" >&2; echo >&2; fi ;;
  home)
    if [[ -t 0 && -t 2 ]]; then exec bash "$S/ai-home.sh"; fi
    usage ;;
  help|--help|-h)
    # loomy help <commande> : aide de cette commande.
    if [[ -n "${1:-}" && "$1" != "help" ]]; then exec "$LOOMY_HOME/bin/loomy" "$1" --help; fi
    usage ;;
  uninstall)
    ui_banner "$(t "Uninstall Loomy")" "$(t "nothing is deleted automatically")"
    ui_section "$(t "INSTALLS")" "$(t "one command per install found")"
    n=0
    while IFS=$'\t' read -r m h p; do
      [[ -n "$m" ]] || continue; n=$(( n + 1 ))
      ui_rail "${C_BOLD}$m${C_RESET} ${C_DIM}${h/#$HOME/~}${C_RESET}"
      ui_rail "    $(uninstall_cmd "$m" "$h" "$p")"
    done < <(loomy_installs)
    if (( n == 0 )); then ui_rail "$(install_method) ${C_DIM}${LOOMY_HOME/#$HOME/~}${C_RESET}"; ui_rail "    $(uninstall_cmd "$(install_method)" "$LOOMY_HOME" "$INVOKED")"; fi
    ui_section "$(t "IN YOUR PROJECTS")"
    ui_rail "$(t "Each project keeps its %s folder: the lead agent uses it to delegate and track phases." "${C_BOLD}.loomy/${C_RESET}")"
    ui_rail "$(t "To remove Loomy from a project:") ${C_BOLD}rm -rf .loomy START.md${C_RESET} ${C_DIM}($(t "and the .loomy/logs/ line in .gitignore"))${C_RESET}"
    ui_rail "${C_DIM}$(t "Personal settings: %s" "$(loomy_config_file | sed "s|^$HOME|~|")")${C_RESET}"
    ui_end "$(t "run the command that matches your install")"
    ;;
  *) t "Unknown command: %s" "$cmd" >&2; echo >&2; usage >&2; exit 2 ;;
esac
